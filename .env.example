# SQLite — no database server required. Must match `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- AI providers ---
# Google AI Studio key — covers BOTH Gemini and Gemma. https://aistudio.google.com/apikey
GEMINI_API_KEY="your-google-ai-studio-key"
# Optional. OpenAI is skipped entirely unless this is non-empty.
OPENAI_API_KEY=""

# Ordered fallback chain, tried left to right on quota / availability / model errors.
# Providers without a configured API key are dropped automatically.
LLM_PROVIDER_CHAIN="gemma,gemini,openai"

# Model id overrides (optional)
GEMINI_MODEL="gemini-3.7-flash"
GEMMA_MODEL="gemma-4-31b-it"
OPENAI_MODEL="gpt-4o-mini"
# How Gemma is asked for structured output: strict | json_object | text
GEMMA_STRUCTURED_MODE="json_object"

REDIS_URL="redis://localhost:6379"
USE_BULLMQ="false"
UPLOAD_DIR="./uploads"
PORT=3000
